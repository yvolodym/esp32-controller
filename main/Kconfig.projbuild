menu "ESP32 Controller Configuration"

    config CONTROLLER_RECEIVER_MAC
        string "Receiver MAC Address"
        default "FF:FF:FF:FF:FF:FF"
        help
            MAC address of the ESP-NOW receiver device in format XX:XX:XX:XX:XX:XX
            Use FF:FF:FF:FF:FF:FF for broadcast or set specific receiver MAC

    config CONTROLLER_SEND_DELAY_MS
        int "Send delay in milliseconds"
        range 10 1000
        default 20
        help
            Delay between ESP-NOW transmissions

    config CONTROLLER_JOYSTICK_DEADZONE
        int "Joystick deadzone"
        range 10 200
        default 50
        help
            Deadzone for joystick input filtering

endmenu